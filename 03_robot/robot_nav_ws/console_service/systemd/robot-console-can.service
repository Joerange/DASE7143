[Unit]
Description=Restricted Bunker CAN interface helper
After=network.target

[Service]
Type=simple
User=root
Group=dase-orinnx
ExecStart=/usr/bin/python3 /usr/local/lib/robot-console/can_helper.py
RuntimeDirectory=robot-console
RuntimeDirectoryMode=0750
UMask=0007
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/run/robot-console

[Install]
WantedBy=multi-user.target
